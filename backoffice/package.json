{
  "name": "@modus/backoffice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix ../e2e run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && npm --prefix ../e2e run format",
    "format:check": "prettier --check . && npm --prefix ../e2e run format:check",
    "test:e2e": "npm --prefix ../e2e run test",
    "test:e2e:ui": "npm --prefix ../e2e run test:ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.2.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
